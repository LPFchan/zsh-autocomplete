#!/bin/zsh
# Omnibar module. Loaded last by `.autocomplete__main`, so it can override what
# the other modules set up.
#
# Turning this off restores stock Autocomplete behaviour:
#
#   zstyle ':autocomplete:omnibar' enabled no
#
# The module system in `.autocomplete__main` gates every module on that style,
# so no extra plumbing is needed for the escape hatch.

# Autoload the completer explicitly instead of relying on `compinit` to pick it
# up from Completions/.
#
# `compinit` only registers what it finds when it runs, and it does not always
# get there: it runs from the compinit module's own `precmd`, is skipped
# entirely when a readable dump already exists, and in some environments never
# registers this plugin's Completions/ directory at all (upstream's own
# `_autocomplete__unambiguous` goes missing the same way). When that happens
# `_main_complete` fails with "command not found: _omnibar", the completer
# produces nothing, and the list is silently empty -- which looks exactly like
# a broken feature rather than a missing autoload.
#
# `~autocomplete/Completions` is put on $fpath by the plugin entry point, so
# autoloading by name here is enough and costs nothing when compinit did work.
# Upstream's own helpers go missing the same way -- `_autocomplete__unambiguous`
# in particular, whose "command not found" is printed straight onto the prompt
# line and visibly corrupts the display.
builtin autoload -Uz _omnibar \
    _autocomplete__unambiguous \
    _autocomplete__should_insert_unambiguous \
    _autocomplete__history_lines \
    _autocomplete__recent_paths \
    _autocomplete__should_add_space \
    _autocomplete__compadd_opts_len

# One completer replaces Autocomplete's chain. `_omnibar` drives the chain
# itself so it can intercept everything on the way out, and `_ignored` stays
# behind it as the usual fallback.
builtin zstyle ':completion:*' completer _omnibar _ignored

# The omnibar is one ranked list, so the history/completion toggle has nothing
# left to switch between. Neutralise it rather than leaving a key that puts the
# list into a mode the ranking does not apply to.
.autocomplete:async:toggle-context() {
  return 0
}

##
# Everything below has to happen at the first prompt rather than here.
#
# `.autocomplete__main` runs the modules while the plugin is being sourced,
# which is *before* the rest of the user's .zshrc. Anything this module decides
# now can be overridden a few lines later by their own `zstyle` calls. The
# module system gives every module an optional `:precmd` that runs at the first
# prompt instead, which is after .zshrc has finished.
#
${0}:precmd() {
  emulate -L zsh
  setopt $_autocomplete__func_opts[@]

  # `default-context` must go, and it is not merely cosmetic.
  #
  # `.autocomplete:async:reset-context` applies it to `curcontext` at the start
  # of every command line, and `.autocomplete:async:list-choices:main-complete`
  # then switches on `curcontext`:
  #
  #     case $curcontext in
  #     *history-* ) ... - history-lines _autocomplete__history_lines ;;
  #
  # That branch calls `_main_complete` with an explicit completer, which
  # bypasses the `completer` style set above entirely -- so with
  # `default-context history-incremental-search-backward` in .zshrc, `_omnibar`
  # never runs at all and the list silently falls back to history-only.
  local -a pattern=()
  local line=
  for line in ${(f)"$( builtin zstyle -L '*' default-context 2> /dev/null )"}; do
    pattern=( ${(z)line} )
    (( $#pattern >= 2 )) &&
        builtin zstyle -d "${(Q)pattern[2]}" default-context 2> /dev/null
  done

  # Re-assert both for the same reason: a .zshrc that sets its own `completer`
  # style would otherwise take precedence, and compinit may have run in between
  # and replaced the function table.
  builtin autoload -Uz _omnibar \
      _autocomplete__unambiguous \
      _autocomplete__should_insert_unambiguous \
      _autocomplete__history_lines \
      _autocomplete__recent_paths \
      _autocomplete__should_add_space \
      _autocomplete__compadd_opts_len
  builtin zstyle ':completion:*' completer _omnibar _ignored
}
