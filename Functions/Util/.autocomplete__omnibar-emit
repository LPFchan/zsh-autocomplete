#!/bin/zsh
# Emits collected candidates in ranked order as one flat group.
#
# Several `compadd -V <same-name>` calls merge into a single unsorted group and
# keep the order they were called in, which is what makes a ranked list
# possible at all: each run of candidates sharing an option set is emitted as
# its own compadd, and the runs go out in rank order.
#
# Per-run option sets are preserved because options like -S (suffix), -Q (no
# quoting) and -R (suffix-removal function) apply per compadd call, not per
# match. Collapsing everything into a single call would give every match the
# first run's insertion behaviour.

setopt localoptions extendedglob

local group
zstyle -s ":autocomplete:omnibar:" group-name group ||
    group=omnibar

# Only ever show a screenful. Chrome shows a handful; emitting 1500 rows one
# per line would be unreadable and slow to draw.
# Fill the window. Autocomplete's own budget is
# `min(16, LINES - BUFFERLINES - 1)`, so on anything taller than a small
# terminal the 16 binds and half the screen goes unused. Here the window is
# the limit, and 16 is only a fallback for when LINES is not available.
#
# One row is held back for the "show more" row so that adding it cannot push
# the list past the last line -- overflowing gets zsh's "do you wish to see all
# N possibilities?" fallback, since Autocomplete disables the list pager.
local -i shown avail
(( avail = LINES - BUFFERLINES - 1 ))
if zstyle -s ":autocomplete:omnibar:" list-lines shown; then
  :
elif (( avail > 0 )); then
  (( shown = avail - 1 ))
else
  shown=16
fi
(( shown > 0 )) || shown=16

local -a order=( $_omnibar_order )

# Cap the history block. Ranking will happily return twenty near-identical
# `git clone ...` lines, which crowds out the completions and reads as noise;
# a handful of the most recent is all that is useful.
# History takes a share of the window rather than a fixed count, so a taller
# terminal shows more of both sources instead of more completions only.
# Completions then take every row history leaves, so nothing is wasted when
# there is little matching history.
#
# A share rather than the whole list because history-first ordering would
# otherwise let a query with plenty of matching history fill the screen and
# push the completions off it entirely.
local -i hist_max
if ! zstyle -s ":autocomplete:omnibar:" history-lines hist_max; then
  (( hist_max = shown / 2 ))
  (( hist_max < 1 )) && hist_max=1
fi

# How many times "show more" has been pressed for *this* input. A stale count
# from a previous command line is ignored rather than reset, because this runs
# in a forked child whose writes would be discarded anyway.
local -i more=0
[[ $BUFFER == $_omnibar_more_buffer ]] &&
    (( more = ${_omnibar_more:-0} ))

# Only the history share grows. The total is left alone because it is bounded
# by the window, not by choice: the plugin disables zsh's list pager
# (.autocomplete__config deletes `list-prompt` and unsets LISTPROMPT), so a
# list taller than the screen falls back to zsh asking "do you wish to see all
# 49 possibilities?" instead of scrolling. Growing the total past the window
# produced exactly that.
#
# Completions already take every row history does not, so there is nothing to
# expand on that side -- "N more completions" simply means more than fit on
# screen, which no setting here can change. Expanding therefore reallocates
# the screen rather than enlarging it.
(( hist_max += hist_max * more ))
(( hist_max > shown - 2 )) &&
    (( hist_max = shown - 2 ))

local -a capped=()
local -i seen_h=0 _oi
for _oi in $order; do
  if [[ $_omnibar_src[_oi] == h ]]; then
    (( seen_h++ >= hist_max )) &&
        continue
  fi
  capped+=( $_oi )
done
order=( $capped )

(( $#order > shown )) &&
    order=( $order[1,shown] )

# Nerd Font icons. A blended list mixes two row shapes -- a bare command line
# and a padded `name -- description` -- and with nothing to tell them apart the
# eye cannot group them. A leading glyph per kind restores that, which is how a
# browser's address bar stays readable with mixed row types.
#
# On by default; needs a Nerd Font. To turn them off:
#   zstyle ':autocomplete:omnibar:' icons no
# Individually overridable:
#   zstyle ':autocomplete:omnibar:icons' history $'\uf1da'
local -i use_icons=1
zstyle -T ":autocomplete:omnibar:" icons ||
    use_icons=0

local -A icon=()
if (( use_icons )); then
  # Literal UTF-8, not $'\uXXXX': those are converted at run time and fail
  # with "character not in range" in a non-UTF-8 locale, which took out the
  # whole list rather than just the glyphs.
  #
  # Everything here is prefixed `_omni_`. This code runs inside the completion
  # machinery, where bare names like `spec`, `k`, `v` and `tmp` are in common
  # use; declaring them here leaked `spec=( ... )` onto the prompt line.
  local -a _omni_spec=(
      history          
      command          
      executable       
      builtin          
      alias            
      function         
      parameter        
      option           
      file             
      globbed-file     
      directory        
      local-directory  
      default          
  )
  local _omni_k= _omni_v= _omni_tmp=
  while (( $#_omni_spec )); do
    _omni_k=$_omni_spec[1] _omni_v=$_omni_spec[2]
    shift 2 _omni_spec
    _omni_tmp=
    # zstyle -s cannot assign into an associative-array element, so go via a
    # plain scalar.
    if zstyle -s ":autocomplete:omnibar:icons" $_omni_k _omni_tmp; then
      icon[$_omni_k]=$_omni_tmp
    else
      icon[$_omni_k]=$_omni_v
    fi
  done
fi

# Build each row now, and use the finished text to filter. Two things can only
# be judged once the row exists:
#
#   * the history cap, so a run of twenty near-identical `git clone ...` lines
#     cannot crowd out the completions
#   * duplicate rows. De-duplicating on the raw match string is not enough:
#     two long commands differing only past the truncation point produce rows
#     that are character-for-character identical on screen, which reads as a
#     bug rather than as two different commands.
# The command line up to (but not including) the word being completed. A
# browser's address bar shows every suggestion as a full continuation of what
# was typed -- `git c` becomes `git clone`, `git commit`, `git config` -- so
# the rows are all the same shape and visibly related to the input. A bare
# `checkout` does not read as a continuation of `git c`, which is most of why
# the list looked like unrelated fragments next to the full history lines.
#
# Display only. The inserted value stays the single word compadd was given.
local _omni_ctx=
if (( CURRENT > 1 )); then
  _omni_ctx="${(j: :)words[1,CURRENT-1]} "
fi

# What has actually been typed. Every row begins with this -- completions
# because the context is prepended above, history because its matching is
# anchored to the same text -- so it can be de-emphasised at a fixed offset.
local _omni_typed="$_omni_ctx$PREFIX$SUFFIX"
local -i _omni_tlen=$#_omni_typed

# Dim the typed part of each row and leave the rest at normal intensity, which
# is the terminal's version of what a browser's address bar does with font
# weight: you see at a glance which characters are yours and which are the
# suggestion. Escapes are spliced in *after* truncation, because zsh counts
# them toward the display width when it pads the row.
local _omni_dim= _omni_off=
local -i _omni_esclen=0
if zstyle -T ":autocomplete:omnibar:" dim-typed; then
  zstyle -s ":autocomplete:omnibar:" dim-sequence _omni_dim ||
      _omni_dim=$'\e[2m'
  # \e[22m (normal intensity) rather than \e[0m (reset everything): a full
  # reset would also clear the inverse video zsh puts on the selected row, so
  # the highlight would stop halfway across it.
  _omni_off=$'\e[22m'
  (( _omni_esclen = ${#_omni_dim} + ${#_omni_off} ))
fi

typeset -ga _omnibar_row=()
local -a kept=()
local -A row_seen=()
local -i seen_h=0 _oi=0
local _omni_glyph= _omni_tag= _omni_line= _omni_body=

for _oi in $order; do
  if [[ $_omnibar_src[_oi] == h ]]; then
    (( seen_h >= hist_max )) &&
        continue
  fi

  # History entries are already whole command lines; completions are a single
  # word and get the context prepended so they read as continuations too.
  if [[ $_omnibar_src[_oi] == h ]]; then
    _omni_body="$_omnibar_disp[_oi]"
  else
    _omni_body="$_omni_ctx$_omnibar_disp[_oi]"
  fi

  if (( use_icons )); then
    # Completion tags are plural (`commands`, `options`); drop the trailing s
    # so one table entry covers both spellings.
    _omni_tag=${${_omnibar_tag[_oi]:-default}%s}
    _omni_glyph="${icon[$_omni_tag]:-$icon[default]} "
  else
    _omni_glyph=
  fi

  # Fit the plain text first. Truncating after the escapes are in would count
  # them as visible characters and cut the row short. The `m` flag measures
  # display width rather than bytes, so the glyph is counted correctly. The
  # ellipsis marks a clipped row as clipped, rather than looking like a
  # command that genuinely ends mid-word.
  # Subtract the escape sequences from the budget as well. zsh measures the
  # raw string when it works out how many screen lines a row needs, escapes
  # included, so a row that fits on paper is counted as two lines and the
  # listing turns into "do you wish to see all 16 possibilities (32 lines)?".
  local -i _omni_budget=$(( COLUMNS - 1 - ${#_omni_glyph} - _omni_esclen ))
  (( _omni_budget < 8 )) && _omni_budget=8
  if (( ${#_omni_body} > _omni_budget )); then
    _omni_body="${(mr:_omni_budget-1:)_omni_body}…"
  fi
  _omni_body="${(mr:_omni_budget:)_omni_body}"

  # De-duplicate on the plain text: two long commands differing only past the
  # cut render as identical rows, which reads as a bug.
  [[ -n ${row_seen[$_omni_glyph$_omni_body]-} ]] &&
      continue
  row_seen[$_omni_glyph$_omni_body]=1

  if [[ -n $_omni_dim ]] && (( _omni_tlen > 0 )) &&
      [[ $_omni_body[1,_omni_tlen] == $_omni_typed ]]; then
    _omni_line="$_omni_glyph$_omni_dim$_omni_body[1,_omni_tlen]$_omni_off$_omni_body[_omni_tlen+1,-1]"
  else
    _omni_line="$_omni_glyph$_omni_body"
  fi

  [[ $_omnibar_src[_oi] == h ]] &&
      (( seen_h++ ))

  kept+=( $_oi )
  _omnibar_row+=( "$_omni_line" )

  (( $#kept >= shown )) &&
      break
done

order=( $kept )

# How much was held back, so the hint can say so. Counted from the ranked set
# rather than the kept set, and per source, since the two are capped
# separately.
local -i total_h=0 total_c=0 kept_h=0 kept_c=0
for _oi in $_omnibar_order; do
  [[ $_omnibar_src[_oi] == h ]] && (( total_h++ )) || (( total_c++ ))
done
for _oi in $kept; do
  [[ $_omnibar_src[_oi] == h ]] && (( kept_h++ )) || (( kept_c++ ))
done
local -i more_h=$(( total_h - kept_h )) more_c=$(( total_c - kept_c ))

# Walk the ranked order and mark where the option set changes; each span
# between boundaries becomes one compadd.
local -i i idx cur=-1 start=1
local -a bounds=()
for (( i = 1; i <= $#order; i++ )); do
  idx=$order[i]
  if (( _omnibar_optset[idx] != cur )); then
    (( i > 1 )) &&
        bounds+=( "$start:$((i - 1)):$cur" )
    cur=$_omnibar_optset[idx]
    start=$i
  fi
done
(( $#order )) &&
    bounds+=( "$start:$#order:$cur" )

local -i from to set_id j
local spec
for spec in $bounds; do
  from=${spec%%:*}
  to=${${spec#*:}%%:*}
  set_id=${spec##*:}

  typeset -ga _omnibar_run_match=() _omnibar_run_disp=()
  for (( j = from; j <= to; j++ )); do
    idx=$order[j]
    _omnibar_run_match+=( "$_omnibar_match[idx]" )
    _omnibar_run_disp+=( "$_omnibar_row[j]" )
  done

  # -l with -d lists one display string per line, which is the row-per-entry
  # shape an omnibar wants instead of zsh's default packed columns.
  # -U: do not re-filter against the current word. The candidates were
  # generated by the completion system under its own matcher specs (which
  # allow fuzzy, non-prefix matches) and then deliberately chosen and ordered
  # here. Letting compadd apply prefix matching a second time silently drops
  # exactly the fuzzy matches the user configured Autocomplete to find.
  builtin compadd -U -V "$group" -l -d _omnibar_run_disp \
      "${(@P)${:-_omnibar_opts_$set_id}}" \
      -- "${(@)_omnibar_run_match}"
done

# "Show more" row, last in the group so it sits at the bottom of the list.
#
# It is a real match, because zsh has no row that runs an action: the text is
# the word already typed plus a marker, and the line-pre-redraw hook strips the
# marker and re-renders larger. -Q keeps the marker unquoted, -S '' stops a
# space being appended, -U stops compadd re-filtering it.
#
# One row rather than one per source. Both sections widen together, so two rows
# would be two ways to do the same thing -- and giving them distinct match
# strings meant padding one with whitespace the hook then failed to strip.
if (( more_h > 0 && hist_max < shown - 2 )) && [[ -n $_OMNIBAR_MORE ]]; then
  local -a _omni_more_m=( "$PREFIX$SUFFIX$_OMNIBAR_MORE" )
  local _omni_more_glyph=
  (( use_icons )) &&
      _omni_more_glyph="${icon[default]} "

  # Only history is offered, because only history is actionable; see the note
  # on the total above. Mentioning the withheld completions would advertise
  # something selecting the row cannot deliver.
  local _omni_more_text="show $more_h more from history"
  (( more_h == 1 )) &&
      _omni_more_text="show 1 more from history"

  # Build the row first: parameter-expansion flags apply to a single named
  # parameter, not to a concatenation, which is a "bad substitution".
  local _omni_more_row="$_omni_more_glyph$_omni_more_text"
  local -a _omni_more_d=( "${(mr:COLUMNS-1:)_omni_more_row}" )

  builtin compadd -U -Q -S '' -V "$group" -l -d _omni_more_d \
      -- "${(@)_omni_more_m}"
fi

return 0
