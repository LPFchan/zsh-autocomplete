#!/bin/zsh
# Emits collected candidates in ranked order as one flat group.
#
# Several `compadd -V <same-name>` calls merge into a single unsorted group and
# keep the order they were called in, which is what makes a ranked list
# possible at all: each run of candidates sharing an option set is emitted as
# its own compadd, and the runs go out in rank order.
#
# Per-run option sets are preserved because options like -S (suffix), -Q (no
# quoting) and -R (suffix-removal function) apply per compadd call, not per
# match. Collapsing everything into a single call would give every match the
# first run's insertion behaviour.

setopt localoptions extendedglob

local group
zstyle -s ":autocomplete:omnibar:" group-name group ||
    group=omnibar

# Only ever show a screenful. Chrome shows a handful; emitting 1500 rows one
# per line would be unreadable and slow to draw.
local -i shown
zstyle -s ":autocomplete:omnibar:" list-lines shown ||
    shown=${_autocomplete__max_lines:-16}
(( shown > 0 )) || shown=16

local -a order=( $_omnibar_order )
(( $#order > shown )) &&
    order=( $order[1,shown] )

# Nerd Font icons. A blended list mixes two row shapes -- a bare command line
# and a padded `name -- description` -- and with nothing to tell them apart the
# eye cannot group them. A leading glyph per kind restores that, which is how a
# browser's address bar stays readable with mixed row types.
#
# On by default; needs a Nerd Font. To turn them off:
#   zstyle ':autocomplete:omnibar:' icons no
# Individually overridable:
#   zstyle ':autocomplete:omnibar:icons' history $'\uf1da'
local -i use_icons=1
zstyle -T ":autocomplete:omnibar:" icons ||
    use_icons=0

local -A icon=()
if (( use_icons )); then
  # Literal UTF-8, not $'\uXXXX': those are converted at run time and fail
  # with "character not in range" in a non-UTF-8 locale, which took out the
  # whole list rather than just the glyphs.
  #
  # Everything here is prefixed `_omni_`. This code runs inside the completion
  # machinery, where bare names like `spec`, `k`, `v` and `tmp` are in common
  # use; declaring them here leaked `spec=( ... )` onto the prompt line.
  local -a _omni_spec=(
      history          
      command          
      executable       
      builtin          
      alias            
      function         
      parameter        
      option           
      file             
      globbed-file     
      directory        
      local-directory  
      default          
  )
  local _omni_k= _omni_v= _omni_tmp=
  while (( $#_omni_spec )); do
    _omni_k=$_omni_spec[1] _omni_v=$_omni_spec[2]
    shift 2 _omni_spec
    _omni_tmp=
    # zstyle -s cannot assign into an associative-array element, so go via a
    # plain scalar.
    if zstyle -s ":autocomplete:omnibar:icons" $_omni_k _omni_tmp; then
      icon[$_omni_k]=$_omni_tmp
    else
      icon[$_omni_k]=$_omni_v
    fi
  done
fi

# Walk the ranked order and mark where the option set changes; each span
# between boundaries becomes one compadd.
local -i i idx cur=-1 start=1
local -a bounds=()
for (( i = 1; i <= $#order; i++ )); do
  idx=$order[i]
  if (( _omnibar_optset[idx] != cur )); then
    (( i > 1 )) &&
        bounds+=( "$start:$((i - 1)):$cur" )
    cur=$_omnibar_optset[idx]
    start=$i
  fi
done
(( $#order )) &&
    bounds+=( "$start:$#order:$cur" )

local -i from to set_id j
local spec
for spec in $bounds; do
  from=${spec%%:*}
  to=${${spec#*:}%%:*}
  set_id=${spec##*:}

  typeset -ga _omnibar_run_match=() _omnibar_run_disp=()
  local _omni_glyph= _omni_tag= _omni_line=
  for (( j = from; j <= to; j++ )); do
    idx=$order[j]
    _omnibar_run_match+=( "$_omnibar_match[idx]" )

    if (( use_icons )); then
      # Completion tags are plural (`commands`, `options`); drop the trailing
      # s so one table entry covers both spellings.
      _omni_tag=${${_omnibar_tag[idx]:-default}%s}
      _omni_glyph=${icon[$_omni_tag]:-$icon[default]}
      _omni_line="$_omni_glyph ${_omnibar_disp[idx]}"
    else
      _omni_line="$_omnibar_disp[idx]"
    fi

    # Truncate here, once the row is fully built. Doing it in the source
    # instead leaves the glyph and its space unaccounted for, so a full-width
    # history line spills onto a second row and the redraw goes to pieces.
    # The `m` flag counts display width, not bytes, so wide glyphs are safe.
    _omnibar_run_disp+=( "${(mr:COLUMNS-1:)_omni_line}" )
  done

  # -l with -d lists one display string per line, which is the row-per-entry
  # shape an omnibar wants instead of zsh's default packed columns.
  # -U: do not re-filter against the current word. The candidates were
  # generated by the completion system under its own matcher specs (which
  # allow fuzzy, non-prefix matches) and then deliberately chosen and ordered
  # here. Letting compadd apply prefix matching a second time silently drops
  # exactly the fuzzy matches the user configured Autocomplete to find.
  builtin compadd -U -V "$group" -l -d _omnibar_run_disp \
      "${(@P)${:-_omnibar_opts_$set_id}}" \
      -- "${(@)_omnibar_run_match}"
done

return 0
