#!/bin/zsh
# Scores every collected candidate on one scale and writes the display order
# into `_omnibar_order`. Lower sorts earlier.
#
# The two sources are not directly comparable and must not be scored against
# the same text. A completion is a single word, so it is matched against the
# current word: typing `c` makes `checkout` a position-0 hit. A history entry
# is a whole command line, so it is matched against everything typed so far:
# typing `git c` makes `git checkout -b ...` a position-0 hit too. Scoring both
# against the current word instead buries history, because `c` only turns up
# several characters into the line -- which is what a first attempt here did.
#
# Candidate length is deliberately not penalised. It reads as a reasonable
# tie-breaker and then quietly ranks every history entry last, since command
# lines are always longer than the single words completion produces.
#
# There is no correct cross-source ranking, only a preference, so the weights
# are styles. Defaults are a starting point meant to be tuned by feel:
#
#   zstyle ':autocomplete:omnibar:' weight-position 100  # per char before match
#   zstyle ':autocomplete:omnibar:' weight-rank      10  # per place within source
#   zstyle ':autocomplete:omnibar:' bias-history      0  # < 0 favours history
#   zstyle ':autocomplete:omnibar:' bias-completion   0  # < 0 favours completions

setopt localoptions extendedglob

local -i w_pos w_rank bias_h bias_c
zstyle -s ":autocomplete:omnibar:" weight-position w_pos  || w_pos=100
zstyle -s ":autocomplete:omnibar:" weight-rank     w_rank || w_rank=10
zstyle -s ":autocomplete:omnibar:" bias-history    bias_h || bias_h=0
zstyle -s ":autocomplete:omnibar:" bias-completion bias_c || bias_c=0

# What a completion is matched against: the word under the cursor.
local needle_c=$PREFIX$SUFFIX

# What a history entry is matched against: the command line so far.
local -a _omni_typed=( ${(@)words[1,CURRENT]} )
_omni_typed=( ${_omni_typed:#} )
local needle_h="${(j: :)_omni_typed}"

local -i n=$#_omnibar_match i pos score hrank=0
local cand needle
local -a keyed=()

for (( i = 1; i <= n; i++ )); do
  cand=$_omnibar_match[i]

  if [[ $_omnibar_src[i] == h ]]; then
    needle=$needle_h
  else
    needle=$needle_c
  fi

  # Where the needle turns up. A plain (i) subscript returns one past the end
  # when absent, which would read as the best possible position, so clamp it.
  if [[ -z $needle ]]; then
    pos=0
  else
    pos=${cand[(i)$needle]}
    (( pos > $#cand )) && pos=$#cand
    (( pos-- ))
  fi

  if [[ $_omnibar_src[i] == h ]]; then
    # Collection order is recency order here, so it carries real information:
    # it lets recent history compete at the top while older entries decay
    # below the completions.
    (( score = bias_h + w_pos * pos + w_rank * hrank++ ))
  else
    # Collection order is NOT quality order for completions -- the completion
    # system emits them roughly alphabetically. Charging for position in that
    # list penalised good matches for turning up late, which is how `checkout`
    # ended up ranked below `add` when the typed word was `c`.
    (( score = bias_c + w_pos * pos ))
  fi

  (( score < 0 )) && score=0

  # Zero-pad so a plain lexical sort orders numerically; sorting integers with
  # (n) on every keystroke is measurably slower. The index tie-breaks, which
  # keeps ties in collection order -- history first, since it is collected
  # before completions.
  keyed+=( "${(l:10::0:)score}:${(l:6::0:)i}" )
done

# Emission passes -U, which switches off compadd's own duplicate rejection
# (it has to: -U is also what stops compadd re-filtering our chosen matches).
# The completion system does legitimately offer the same match more than once
# under different tags, so de-duplicate here instead, keeping whichever copy
# ranked best.
local -A seen=()
local -a final=()
local -i idx
for idx in ${${(@o)keyed}#*:}; do
  idx=${idx##0##}
  cand=$_omnibar_match[idx]
  [[ -n ${seen[$cand]-} ]] &&
      continue
  seen[$cand]=1
  final+=( $idx )
done

typeset -ga _omnibar_order=( $final )
return 0
